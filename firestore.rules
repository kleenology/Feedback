rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* الأدمن = من له وثيقة باسم معرّفه في admins.
       قبل هذا كان أي مسجّل دخول يُعد أدمن، وهذا ما ينفع بعد ما صار العملاء
       يسجّلون دخولهم من التطبيق — العميل مسجّل دخول أيضاً. */
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isUser(uid) { return request.auth != null && request.auth.uid == uid; }
    /* جوال العميل في المستند لازم يكون جواله هو: رمز الدخول (PIN/SMS عبر خادمنا) يحمل ph،
       ودخول فايربيس بالجوال يحمل phone_number. بدونه يقدر عميل يكتب رقم غيره في طلبه */
    function ownPhone(ph) {
      return ph is string && ph.size() > 0 && (
        request.auth.token.get('ph', '') == ph ||
        request.auth.token.get('phone_number', '') == '+' + ph);
    }
    /* دخول بالإيميل: الجوال ما يتأكد (مثل الرمز المؤقت) — يكتبه العميل مرة في ملفه بصيغة سعودية،
       وطلباته لازم تحمل نفس الجوال اللي في ملفه */
    function emailUser() {
      return request.auth != null && request.auth.token.get('firebase', {}).get('sign_in_provider', '') == 'password';
    }
    function saPhone(ph) { return ph is string && ph.matches('^9665[0-9]{8}$'); }
    function profilePhone(ph) {
      return emailUser() && saPhone(ph) &&
        exists(/databases/$(database)/documents/customers/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/customers/$(request.auth.uid)).data.ph == ph;
    }
    // معرّفات الطلبات تُعرض في أزرار اللوحة — نقصرها على حروف آمنة
    function safeId(id) { return id.matches('^[A-Za-z0-9_-]{1,40}$'); }

    // قائمة معرّفات الأدمن — تُدار من Firebase Console فقط، ولا تُكتب من التطبيق أبداً
    match /admins/{uid} {
      allow read: if isUser(uid) || isAdmin();
      allow write: if false;
    }

    // تقييمات العملاء
    match /reviews/{reviewId} {

      // أي زائر يقدر "ينشئ" تقييم جديد فقط، بشرط أن تكون بياناته سليمة
      allow create: if
        request.resource.data.keys().hasOnly(['n','ph','o','c','p','tw','r','nt','cp','ts','used','tm','ok']) &&
        (!('tm' in request.resource.data) || (request.resource.data.tm is string && request.resource.data.tm.size() <= 50)) &&
        (!('ok' in request.resource.data) || request.resource.data.ok is bool) &&
        request.resource.data.o is int && request.resource.data.o >= 1 && request.resource.data.o <= 5 &&
        request.resource.data.c is int && request.resource.data.c >= 1 && request.resource.data.c <= 5 &&
        request.resource.data.p is int && request.resource.data.p >= 1 && request.resource.data.p <= 5 &&
        request.resource.data.tw is int && request.resource.data.tw >= 1 && request.resource.data.tw <= 5 &&
        request.resource.data.r is bool &&
        request.resource.data.n is string && request.resource.data.n.size() >= 1 && request.resource.data.n.size() <= 100 &&
        request.resource.data.ph is string && request.resource.data.ph.size() >= 9 && request.resource.data.ph.size() <= 20 &&
        request.resource.data.nt is string && request.resource.data.nt.size() <= 1000 &&
        request.resource.data.cp is string && request.resource.data.cp.size() == 9 &&
        request.resource.data.ts is string && request.resource.data.ts.size() <= 40 &&
        request.resource.data.used == false;

      // القراءة والتعديل والحذف للأدمن وحده
      allow read, update, delete: if isAdmin();
    }

    // التقييمات المنشورة في صفحة العرض العامة
    match /public_reviews/{reviewId} {
      // أي زائر يقدر يقرأها (هذا هدفها)
      allow read: if true;
      // النشر والإخفاء للأدمن فقط
      allow write: if isAdmin();
    }

    // إعدادات لوحة التحكم (أهداف الفرق، يوم الصرف) — للأدمن فقط
    match /settings/{doc} {
      allow read, write: if isAdmin();
    }

    // قائمة أرقام العملاء لرسائل العروض — للأدمن فقط (لا يقرأها أي زائر ولا أي عميل)
    match /contacts/{phone} {
      allow read, write: if isAdmin();
    }

    // الموظفون ورواتبهم — للأدمن فقط
    match /staff/{id} {
      allow read, write: if isAdmin();
    }
    match /payruns/{month} {
      allow read, write: if isAdmin();
    }

    /* ===== تطبيق العميل ===== */

    // ملف العميل وعناوينه — لصاحبه وحده، والأدمن يقرأ فقط
    match /customers/{uid} {
      allow read: if isUser(uid) || isAdmin();
      /* يُنشأ من أول دخول ولو بلا اسم — الاسم يُضاف لاحقاً، و ok موافقة العروض */
      allow create, update: if isUser(uid) &&
        request.resource.data.keys().hasOnly(['n','ph','at','seen','ok','em']) &&
        request.resource.data.ph is string && request.resource.data.ph.size() <= 20 &&
        /* حساب الإيميل ينحفظ من أول دخول بجوال فاضي — عشان يظهر في اللوحة ولو ما كمّل. الطلب نفسه يشترط جوال صحيح (profilePhone) */
        (ownPhone(request.resource.data.ph) ||
          (emailUser() && (saPhone(request.resource.data.ph) || request.resource.data.ph == ''))) &&
        (!('em' in request.resource.data) ||
          (request.resource.data.em is string && request.resource.data.em.size() <= 120)) &&
        (!('n' in request.resource.data) ||
          (request.resource.data.n is string && request.resource.data.n.size() <= 60)) &&
        (!('ok' in request.resource.data) || request.resource.data.ok is bool) &&
        (!('at' in request.resource.data) ||
          (request.resource.data.at is string && request.resource.data.at.size() <= 40)) &&
        (!('seen' in request.resource.data) ||
          (request.resource.data.seen is string && request.resource.data.seen.size() <= 40));
      /* آبل تشترط حذف الحساب من داخل التطبيق (5.1.1(v))، فالعميل يحذف ملفه بنفسه.
         الطلبات تبقى — سجل محاسبي للنشاط، ومكشوف للعميل في سياسة الخصوصية. */
      allow delete: if isUser(uid);

      match /addresses/{aid} {
        allow read, write: if isUser(uid);
        allow read: if isAdmin();
      }
    }

    /* عدّاد المواعيد المحجوزة لكل يوم: {am:1, pm:0, ev:2}
       الحارس الحقيقي ضد الحجز المزدوج — التطبيق يفحص، والقاعدة تمنع.
       ⚠️ SLOT_CAP هنا لازم يطابق SLOT_CAP في app/index.html */
    function SLOT_CAP() { return 1; }
    function slotOk(d, k) {
      return !(k in d) || (d[k] is int && d[k] >= 0 && d[k] <= SLOT_CAP());
    }
    // لا قفزات: كل فترة تتغيّر بمقدار واحد فقط في المرة
    function stepOk(nu, old, k) {
      return !(k in nu) ||
        ((k in old ? nu[k] - old[k] : nu[k]) <= 1 && (k in old ? old[k] - nu[k] : 0) <= 1);
    }
    match /slots/{day} {
      allow read: if request.auth != null;
      // الأدمن يصحّح العدّاد بحرية (إلغاء، تعديل يدوي، إغلاق يوم)
      allow write: if isAdmin();
      allow create: if request.auth != null &&
        request.resource.data.keys().hasOnly(['am','pm','ev']) &&
        slotOk(request.resource.data,'am') && slotOk(request.resource.data,'pm') && slotOk(request.resource.data,'ev');
      allow update: if request.auth != null &&
        request.resource.data.keys().hasOnly(['am','pm','ev']) &&
        slotOk(request.resource.data,'am') && slotOk(request.resource.data,'pm') && slotOk(request.resource.data,'ev') &&
        stepOk(request.resource.data, resource.data,'am') &&
        stepOk(request.resource.data, resource.data,'pm') &&
        stepOk(request.resource.data, resource.data,'ev');
      allow delete: if isAdmin();
    }

    /* رموز التحقق وعدّاداتها: خادم الرموز وحده يكتبها بمفتاح الأدمن، وهو
       يتجاوز هذي القواعد. أي وصول من متصفح ممنوع — قراءة الرمز تعني
       دخول أي حساب، وحذف العدّاد يعني تجاوز سقف الرسائل اليومي. */
    match /otp/{phone} {
      allow read, write: if false;
    }
    match /otp_meta/{doc} {
      allow read, write: if false;
    }

    /* عدّاد أرقام الطلبات. الزيادة مقيّدة بواحد بالضبط — لا قفز ولا رجوع،
       فما يقدر أحد يعيد استخدام رقم صار لطلب غيره. */
    match /counters/{name} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        request.resource.data.keys().hasOnly(['n']) &&
        request.resource.data.n is int && request.resource.data.n == 1;
      allow update: if request.auth != null &&
        request.resource.data.keys().hasOnly(['n']) &&
        request.resource.data.n is int &&
        request.resource.data.n == resource.data.n + 1;
      allow delete: if isAdmin();
    }

    // الطلبات: العميل ينشئ طلبه ويقرأ طلباته ويلغيها قبل التأكيد. الأدمن يدير الكل.
    match /orders/{oid} {
      allow read: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow create: if request.auth != null && safeId(oid) &&
        request.resource.data.uid == request.auth.uid &&
        (ownPhone(request.resource.data.ph) || profilePhone(request.resource.data.ph)) &&
        request.resource.data.st == 'new' &&
        // حقول يكتبها الفريق أو الخادم بس: السعر النهائي، المستلم، الفاتورة
        !request.resource.data.keys().hasAny(['price', 'paid', 'paidAt', 'ostaz', 'ostazLock', 'pays', 'tap']) &&
        // طريقة دفع العربون اللي اختارها العميل — للعرض بس، المدفوع الفعلي يكتبه الخادم بعد ما يتأكد من تاب
        (!('pay' in request.resource.data) || request.resource.data.pay in ['tap', 'bank']) &&
        (!('dep' in request.resource.data) || (request.resource.data.dep is number &&
          request.resource.data.dep >= 0 && request.resource.data.dep <= request.resource.data.est)) &&
        (!('off' in request.resource.data) || (request.resource.data.off is number &&
          request.resource.data.off >= 0 && request.resource.data.off <= 100)) &&
        request.resource.data.svc is string && request.resource.data.svc.size() > 0 && request.resource.data.svc.size() <= 120 &&
        request.resource.data.nt is string && request.resource.data.nt.size() <= 600 &&
        // السلة: قائمة أصناف بحد معقول، والإجمالي تقديري لا يُلزم الشركة
        request.resource.data.items is list && request.resource.data.items.size() <= 60 &&
        // طلب بلا أصناف ما يصير — إلا زيارة التسعير (المعاينة) اللي ما لها أصناف
        (request.resource.data.items.size() > 0 || request.resource.data.get('quote', false) == true) &&
        request.resource.data.est is number && request.resource.data.est >= 0 &&
        // رقم الطلب: نفس قيمة العدّاد بعد زيادته في نفس المعاملة — ما يقدر أحد يكرر رقم طلب غيره
        (!('no' in request.resource.data) || (request.resource.data.no is int &&
          request.resource.data.no == getAfter(/databases/$(database)/documents/counters/orders).data.n + 1000)) &&
        // السعر النهائي بيد الأدمن وحده — العميل ما يكتبه عند الإنشاء
        !('price' in request.resource.data);
      // العميل ما يعدّل إلا الإلغاء، والسعر والحالة بيد الأدمن وحده
      allow update: if isAdmin() ||
        (request.auth != null && resource.data.uid == request.auth.uid &&
         resource.data.st == 'new' && request.resource.data.st == 'cancelled' &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st','hist']));
      allow delete: if isAdmin();
    }

    // المحفظة: العميل يقرأ رصيده وسجلّه بس. أي تغيير (شحن، كود، خصم، استرجاع) من الخادم وحده
    match /wallets/{uid} {
      allow read: if isUser(uid) || isAdmin();
      allow write: if false;
      match /tx/{id} {
        allow read: if isUser(uid) || isAdmin();
        allow write: if false;
      }
    }
    // أكواد الرصيد: الأدمن يشوفها في اللوحة، والإنشاء والصرف من الخادم وحده
    match /codes/{code} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // إيصالات العربون: مستند لكل طلب بنفس معرّفه. العميل يرفع إيصال طلبه هو فقط
    // (ويقدر يستبدله)، والصورة مضغوطة بحد ~700KB. الأدمن يقرأ ويحذف.
    match /receipts/{oid} {
      function ownsOrder() {
        return exists(/databases/$(database)/documents/orders/$(oid)) &&
          get(/databases/$(database)/documents/orders/$(oid)).data.uid == request.auth.uid;
      }
      function validReceipt() {
        return request.auth != null && safeId(oid) &&
          request.resource.data.uid == request.auth.uid &&
          request.resource.data.img is string &&
          request.resource.data.img.size() < 900000 &&
          request.resource.data.keys().hasOnly(['uid', 'img', 'amt', 'at']) &&
          ownsOrder();
      }
      allow read: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow create: if validReceipt();
      allow update: if validReceipt() && resource.data.uid == request.auth.uid;
      allow delete: if isAdmin();
    }

    // أي مجموعة أخرى: ممنوعة بالكامل
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
