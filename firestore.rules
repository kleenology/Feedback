rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* الأدمن = من له وثيقة باسم معرّفه في admins.
       قبل هذا كان أي مسجّل دخول يُعد أدمن، وهذا ما ينفع بعد ما صار العملاء
       يسجّلون دخولهم من التطبيق — العميل مسجّل دخول أيضاً. */
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isUser(uid) { return request.auth != null && request.auth.uid == uid; }

    // قائمة معرّفات الأدمن — تُدار من Firebase Console فقط، ولا تُكتب من التطبيق أبداً
    match /admins/{uid} {
      allow read: if isUser(uid) || isAdmin();
      allow write: if false;
    }

    // تقييمات العملاء
    match /reviews/{reviewId} {

      // أي زائر يقدر "ينشئ" تقييم جديد فقط، بشرط أن تكون بياناته سليمة
      allow create: if
        request.resource.data.keys().hasOnly(['n','ph','o','c','p','tw','r','nt','cp','ts','used','tm','ok']) &&
        (!('tm' in request.resource.data) || (request.resource.data.tm is string && request.resource.data.tm.size() <= 50)) &&
        (!('ok' in request.resource.data) || request.resource.data.ok is bool) &&
        request.resource.data.o is int && request.resource.data.o >= 1 && request.resource.data.o <= 5 &&
        request.resource.data.c is int && request.resource.data.c >= 1 && request.resource.data.c <= 5 &&
        request.resource.data.p is int && request.resource.data.p >= 1 && request.resource.data.p <= 5 &&
        request.resource.data.tw is int && request.resource.data.tw >= 1 && request.resource.data.tw <= 5 &&
        request.resource.data.r is bool &&
        request.resource.data.n is string && request.resource.data.n.size() >= 1 && request.resource.data.n.size() <= 100 &&
        request.resource.data.ph is string && request.resource.data.ph.size() >= 9 && request.resource.data.ph.size() <= 20 &&
        request.resource.data.nt is string && request.resource.data.nt.size() <= 1000 &&
        request.resource.data.cp is string && request.resource.data.cp.size() == 9 &&
        request.resource.data.ts is string && request.resource.data.ts.size() <= 40 &&
        request.resource.data.used == false;

      // القراءة والتعديل والحذف للأدمن وحده
      allow read, update, delete: if isAdmin();
    }

    // التقييمات المنشورة في صفحة العرض العامة
    match /public_reviews/{reviewId} {
      // أي زائر يقدر يقرأها (هذا هدفها)
      allow read: if true;
      // النشر والإخفاء للأدمن فقط
      allow write: if isAdmin();
    }

    // إعدادات لوحة التحكم (أهداف الفرق، يوم الصرف) — للأدمن فقط
    match /settings/{doc} {
      allow read, write: if isAdmin();
    }

    // قائمة أرقام العملاء لرسائل العروض — للأدمن فقط (لا يقرأها أي زائر ولا أي عميل)
    match /contacts/{phone} {
      allow read, write: if isAdmin();
    }

    // الموظفون ورواتبهم — للأدمن فقط
    match /staff/{id} {
      allow read, write: if isAdmin();
    }
    match /payruns/{month} {
      allow read, write: if isAdmin();
    }

    /* ===== تطبيق العميل ===== */

    // ملف العميل وعناوينه — لصاحبه وحده، والأدمن يقرأ فقط
    match /customers/{uid} {
      allow read: if isUser(uid) || isAdmin();
      allow create, update: if isUser(uid) &&
        request.resource.data.n is string && request.resource.data.n.size() <= 60 &&
        request.resource.data.ph is string && request.resource.data.ph.size() <= 20;
      allow delete: if false;

      match /addresses/{aid} {
        allow read, write: if isUser(uid);
        allow read: if isAdmin();
      }
    }

    // الطلبات: العميل ينشئ طلبه ويقرأ طلباته ويلغيها قبل التأكيد. الأدمن يدير الكل.
    match /orders/{oid} {
      allow read: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow create: if request.auth != null &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.st == 'new' &&
        request.resource.data.svc is string && request.resource.data.svc.size() <= 120 &&
        request.resource.data.nt is string && request.resource.data.nt.size() <= 600 &&
        // السلة: قائمة أصناف بحد معقول، والإجمالي تقديري لا يُلزم الشركة
        request.resource.data.items is list && request.resource.data.items.size() <= 60 &&
        request.resource.data.est is number && request.resource.data.est >= 0 &&
        // السعر النهائي بيد الأدمن وحده — العميل ما يكتبه عند الإنشاء
        !('price' in request.resource.data);
      // العميل ما يعدّل إلا الإلغاء، والسعر والحالة بيد الأدمن وحده
      allow update: if isAdmin() ||
        (request.auth != null && resource.data.uid == request.auth.uid &&
         resource.data.st == 'new' && request.resource.data.st == 'cancelled' &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st','hist']));
      allow delete: if isAdmin();
    }

    // أي مجموعة أخرى: ممنوعة بالكامل
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
